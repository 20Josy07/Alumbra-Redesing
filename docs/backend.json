
{
  "entities": {
    "analysisRecord": {
      "title": "Analysis Record",
      "description": "Represents a single analysis performed by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the analysis."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who performed the analysis."
        },
        "title": {
          "type": "string",
          "description": "A user-defined title for the analysis."
        },
        "originalText": {
            "type": "string",
            "description": "The original text that was analyzed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the analysis was created."
        },
        "rules": {
          "type": "object",
          "properties": {
            "severe_insults_detected": { "type": "array", "items": { "type": "string" } },
            "insults_detected": { "type": "array", "items": { "type": "string" } },
            "control_detected": { "type": "array", "items": { "type": "string" } },
            "gaslighting_detected": { "type": "array", "items": { "type": "string" } },
            "threats_detected": { "type": "array", "items": { "type": "string" } },
            "severe_insult_count": { "type": "number" },
            "insult_count": { "type": "number" },
            "control_count": { "type": "number" },
            "gaslighting_count": { "type": "number" },
            "threat_count": { "type": "number" }
          },
          "required": ["severe_insult_count", "insult_count", "control_count", "gaslighting_count", "threat_count"]
        },
        "score": {
          "type": "object",
          "properties": {
            "score_raw": { "type": "number" },
            "score_percent": { "type": "number" },
            "risk_level": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["score_raw", "score_percent", "risk_level", "message"]
        },
        "help": {
            "type": "object",
            "properties": {
                "title": { "type": "string" },
                "message": { "type": "string" }
            },
            "required": ["title", "message"]
        },
        "ai_suggestion": {
          "type": "string",
          "description": "AI-generated suggestion based on the analysis."
        }
      },
      "required": ["userId", "title", "originalText", "createdAt", "rules", "score", "help", "ai_suggestion"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}/analyses/{analysisId}": {
      "schema": {
        "$ref": "#/entities/analysisRecord"
      },
      "description": "Stores the analysis records for a specific user."
    }
  }
}
