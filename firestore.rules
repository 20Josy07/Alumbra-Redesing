rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnalysisRecord(data) {
      let requiredKeys = ['userId', 'title', 'originalText', 'createdAt', 'rules', 'score', 'help', 'ai_suggestion'];
      let rulesKeys = ['severe_insults_detected', 'insults_detected', 'control_detected', 'gaslighting_detected', 'threats_detected', 'severe_insult_count', 'insult_count', 'control_count', 'gaslighting_count', 'threat_count'];
      let scoreKeys = ['score_raw', 'score_percent', 'risk_level', 'message'];
      let helpKeys = ['title', 'message'];

      return data.keys().hasAll(requiredKeys)
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string
        && data.originalText is string
        && data.createdAt is timestamp
        && data.rules.keys().hasAll(rulesKeys)
        && data.score.keys().hasAll(scoreKeys)
        && data.help.keys().hasAll(helpKeys)
        && data.ai_suggestion is string;
    }
    
    // USERS
    // Users can only read and write their own data.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ANALYSES
      // A user can read, create, update, and delete their own analysis records.
      // Data must conform to the AnalysisRecord schema on create and update.
      match /analyses/{analysisId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isAnalysisRecord(request.resource.data);
        allow update: if isOwner(userId) && isAnalysisRecord(request.resource.data);
      }
    }
  }
}
