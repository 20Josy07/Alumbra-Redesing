ANALYSIS_API_URL=https://alumbra-api.up.railway.app/analyze

# URL pública de la app (sin barra final). Enlaces de restablecer contraseña → /auth/action
NEXT_PUBLIC_APP_URL=https://alumbraia.com

# ─── Alertas por correo (riesgo alto/muy alto) vía Resend ───# Crea una cuenta gratis en https://resend.com y una API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# El dominio del remitente DEBE estar verificado en Resend (SPF/DKIM/DMARC)
# para que los correos no caigan en spam.
ALERT_EMAIL_FROM="Alumbra <alertas@tudominio.com>"
# Correo de respuesta (opcional pero recomendado para entregabilidad).
ALERT_REPLY_TO=soporte@tudominio.com
# Logo de la cabecera del correo (URL pública). Opcional; si no se define se
# usa el favicon de Alumbra. Ideal: alójalo en tu propio dominio.
# ALERT_LOGO_URL=https://alumbraia.com/logo.png

# ─── Pagos con Wompi (Colombia) — https://comercios.wompi.co ───
# Llave pública (se puede exponer, va en el checkout).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxx
# Secreto de integridad: firma el checkout. NUNCA exponer.
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxxxxxx
# Secreto de eventos: valida el webhook. NUNCA exponer.
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxxxxxxxxxx
# Llave privada: consultas a la API de Wompi. NUNCA exponer.
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxx

# Cuenta de servicio Firebase (JSON en una línea): activa planes vía webhook aunque
# el usuario cierre el navegador. Firebase → Project settings → Service accounts → Generate key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
